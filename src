import java.util.LinkedList;
import java.util.Queue;
import java.util.Stack;

/**
 * Manages the question bank (Array), the question Queue (FIFO)
 * and the Stack of wrongly answered questions (LIFO).
 */
public class QuizEngine {
    private Question[] bank;                       // Array: question bank
    private final Queue<Question> questionQueue = new LinkedList<>();  // Queue: FIFO
    private final Stack<Question> wrongAnswers = new Stack<>();        // Stack: LIFO
    private int score;
    private int totalQuestions;

    public QuizEngine() {
        loadQuestions();
    }

    /** Fills the array with the 10 predefined questions. */
    private void loadQuestions() {
        bank = new Question[] {
            new Question("Which data structure works on the FIFO principle?",
                new String[]{"Stack", "Queue", "Array", "Tree"}, 1),
            new Question("Which data structure works on the LIFO principle?",
                new String[]{"Queue", "Array", "Stack", "Tree"}, 2),
            new Question("What is the index of the first element of a Java array?",
                new String[]{"0", "1", "-1", "2"}, 0),
            new Question("Which operation adds an element to a Stack?",
                new String[]{"pop()", "push()", "peek()", "poll()"}, 1),
            new Question("What is the time complexity of accessing arr[i]?",
                new String[]{"O(n)", "O(log n)", "O(1)", "O(n^2)"}, 2),
            new Question("Which Queue method removes and returns the front element?",
                new String[]{"peek()", "add()", "offer()", "poll()"}, 3),
            new Question("What is the time complexity of enqueue in a Queue?",
                new String[]{"O(1)", "O(n)", "O(log n)", "O(n^2)"}, 0),
            new Question("Which sorting algorithm repeatedly selects the smallest element?",
                new String[]{"Merge Sort", "Quick Sort", "Selection Sort", "Heap Sort"}, 2),
            new Question("Which Java class implements a Stack in java.util?",
                new String[]{"HashMap", "Scanner", "Stack", "Random"}, 2),
            new Question("Which keyword is used to create an object in Java?",
                new String[]{"class", "this", "new", "static"}, 2)
        };
        totalQuestions = bank.length;
    }

    /** Clears the Queue and Stack, resets the score and enqueues every question. O(N) */
    public void startQuiz() {
        questionQueue.clear();
        wrongAnswers.clear();
        score = 0;
        for (Question q : bank) {
            questionQueue.add(q);          // enqueue
        }
    }

    public boolean hasNextQuestion() { return !questionQueue.isEmpty(); }

    /** Removes and returns the front question of the Queue (dequeue). */
    public Question nextQuestion() { return questionQueue.poll(); }

    /** Checks the answer; correct -> score+1, wrong -> push on Stack. */
    public boolean submitAnswer(Question q, int choice) {
        if (q.isCorrect(choice)) {
            score++;
            return true;
        }
        wrongAnswers.push(q);              // remember wrong answer
        return false;
    }

    public Stack<Question> getWrongAnswers() { return wrongAnswers; }
    public int getScore() { return score; }
    public int getTotalQuestions() { return totalQuestions; }
}

/**
 * Keeps up to 10 ScoreEntry objects in an array and sorts them
 * from highest score to lowest using Selection Sort.
 */
public class Leaderboard {
    private static final int CAPACITY = 10;
    private final ScoreEntry[] entries = new ScoreEntry[CAPACITY];
    private int count = 0;

    /** Adds a result and re-sorts. If the board is full, the lowest entry is replaced only if the new one is better. */
    public void add(ScoreEntry entry) {
        if (count < CAPACITY) {
            entries[count++] = entry;
        } else if (isBetter(entry, entries[count - 1])) {
            entries[count - 1] = entry;    // array is sorted, so the last entry is the lowest
        } else {
            return;
        }
        sort();
    }

    /** Selection Sort: O(M^2), M <= 10. */
    private void sort() {
        for (int i = 0; i < count - 1; i++) {
            int best = i;
            for (int j = i + 1; j < count; j++) {
                if (isBetter(entries[j], entries[best])) {
                    best = j;
                }
            }
            ScoreEntry temp = entries[i];
            entries[i] = entries[best];
            entries[best] = temp;
        }
    }

    /** Higher score wins; equal scores are ordered alphabetically by name. */
    private boolean isBetter(ScoreEntry a, ScoreEntry b) {
        if (a.getScore() != b.getScore()) {
            return a.getScore() > b.getScore();
        }
        return a.getName().compareToIgnoreCase(b.getName()) < 0;
    }

    public boolean isEmpty() { return count == 0; }

    public void display() {
        System.out.println("\n========== LEADERBOARD ==========");
        if (isEmpty()) {
            System.out.println("No results yet. Play a quiz first!");
        } else {
            System.out.printf("%-6s %-20s %s%n", "Rank", "Name", "Score");
            for (int i = 0; i < count; i++) {
                System.out.printf("%-6d %-20s %d/%d%n", i + 1, entries[i].getName(),
                        entries[i].getScore(), entries[i].getTotal());
            }
        }
        System.out.println("=================================");
    }
}

/**
 * Stores the result of one player: name, score and total number of questions.
 */
public class ScoreEntry {
    private final String name;
    private final int score;
    private final int total;

    public ScoreEntry(String name, int score, int total) {
        this.name = name;
        this.score = score;
        this.total = total;
    }

    public String getName() { return name; }
    public int getScore() { return score; }
    public int getTotal() { return total; }
}

import java.util.Scanner;
import java.util.Stack;

/**
 * Online Quiz System - console menu.
 * Uses Array + Queue + Stack + Selection Sort (DSA project).
 */
public class Main {
    private static final Scanner SC = new Scanner(System.in);

    public static void main(String[] args) {
        QuizEngine engine = new QuizEngine();
        Leaderboard board = new Leaderboard();

        System.out.println("=====================================");
        System.out.println("        ONLINE QUIZ SYSTEM");
        System.out.println("=====================================");

        while (true) {
            System.out.println("\n1. Start Quiz");
            System.out.println("2. View Leaderboard");
            System.out.println("3. Exit");
            int choice = readNumber("Enter your choice (1-3): ", 1, 3);

            if (choice == 1) {
                playQuiz(engine, board);
            } else if (choice == 2) {
                board.display();
            } else {
                System.out.println("Thank you for playing. Goodbye!");
                break;
            }
        }
    }

    private static void playQuiz(QuizEngine engine, Leaderboard board) {
        System.out.print("Enter your name: ");
        String name = SC.hasNextLine() ? SC.nextLine().trim() : "";
        if (name.isEmpty()) {
            name = "Guest";
        }

        engine.startQuiz();
        int number = 1;
        while (engine.hasNextQuestion()) {
            Question q = engine.nextQuestion();
            System.out.println("\nQ" + number + ". " + q.getText());
            String[] opts = q.getOptions();
            for (int i = 0; i < opts.length; i++) {
                System.out.println("   " + (i + 1) + ") " + opts[i]);
            }
            int answer = readNumber("Your answer (1-4): ", 1, 4);
            if (engine.submitAnswer(q, answer)) {
                System.out.println("Correct!");
            } else {
                System.out.println("Wrong! Correct answer: " + q.getCorrectAnswer());
            }
            number++;
        }

        int total = engine.getTotalQuestions();
        System.out.println("\n" + name + ", your score: " + engine.getScore() + "/" + total);
        board.add(new ScoreEntry(name, engine.getScore(), total));
        showReview(engine.getWrongAnswers());
        board.display();
    }

    /** Pops the Stack so the LAST wrong question is shown first (LIFO). */
    private static void showReview(Stack<Question> wrong) {
        if (wrong.isEmpty()) {
            System.out.println("Perfect score! Nothing to review.");
            return;
        }
        System.out.println("\n--- Review of wrong answers (last wrong first) ---");
        while (!wrong.isEmpty()) {
            Question w = wrong.pop();
            System.out.println("Q: " + w.getText());
            System.out.println("   Correct answer: " + w.getCorrectAnswer());
        }
    }

    /** Keeps asking until the player enters a whole number between min and max. */
    private static int readNumber(String prompt, int min, int max) {
        while (true) {
            System.out.print(prompt);
            if (!SC.hasNextLine()) {          // input closed: exit cleanly
                System.out.println("\nNo more input. Exiting.");
                System.exit(0);
            }
            String line = SC.nextLine().trim();
            try {
                int value = Integer.parseInt(line);
                if (value >= min && value <= max) {
                    return value;
                }
            } catch (NumberFormatException e) {
                // fall through to the error message
            }
            System.out.println("Invalid input. Enter a number from " + min + " to " + max + ".");
        }
    }
}

/**
 * Represents one multiple-choice question: text, 4 options and the correct option index.
 */
public class Question {
    private final String text;
    private final String[] options;   // always 4 options
    private final int correctIndex;   // 0-based index of the correct option

    public Question(String text, String[] options, int correctIndex) {
        this.text = text;
        this.options = options;
        this.correctIndex = correctIndex;
    }

    public String getText() { return text; }

    public String[] getOptions() { return options; }

    public String getCorrectAnswer() { return options[correctIndex]; }

    /** @param choice the player's choice, 1 to 4 */
    public boolean isCorrect(int choice) { return choice - 1 == correctIndex; }
}
